-static ssize_t sbp_parse_wwn(const char *name, u64 *wwn)
-{
-	const char *cp;
-	char c, nibble;
-	int pos = 0, err;
-
-	*wwn = 0;
-	for (cp = name; cp < &name[SBP_NAMELEN - 1]; cp++) {
-		c = *cp;
-		if (c == '\n' && cp[1] == '\0')
-			continue;
-		if (c == '\0') {
-			err = 2;
-			if (pos != 16)
-				goto fail;
-			return cp - name;
-		}
-		err = 3;
-		if (isdigit(c))
-			nibble = c - '0';
-		else if (isxdigit(c))
-			nibble = tolower(c) - 'a' + 10;
-		else
-			goto fail;
-		*wwn = (*wwn << 4) | nibble;
-		pos++;
-	}
-	err = 4;
-fail:
-	printk(KERN_INFO "err %u len %zu pos %u\n",
-			err, cp - name, pos);
-	return -1;
-}
