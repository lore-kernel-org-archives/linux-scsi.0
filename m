 /**
+ * qla4xxx_is_intr_poll_mode =E2=80=93 Are we allowed to poll for inte=
rrupts?
+ * @ha: Pointer to host adapter structure.
+ * @ret: 1=3Dpolling mode, 0=3Dnon-polling mode
+ **/
+static int qla4xxx_is_intr_poll_mode(struct scsi_qla_host *ha)
+{
+	int rval =3D 1;
+
+	if (is_qla8032(ha)) {
+		if (test_bit(AF_IRQ_ATTACHED, &ha->flags) &&
+		    test_bit(AF_83XX_MBOX_INTR_ON, &ha->flags))
+			rval =3D 0;
+	} else {
+		if (test_bit(AF_IRQ_ATTACHED, &ha->flags) &&
+		    test_bit(AF_INTERRUPTS_ON, &ha->flags) &&
+		    test_bit(AF_ONLINE, &ha->flags) &&
+		    !test_bit(AF_HA_REMOVAL, &ha->flags))
+			rval =3D 0;
+	}
+
+	return rval;
+}
