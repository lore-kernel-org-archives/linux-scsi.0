+		    ((sh->qd_idx >= 0 && sh->pd_idx == disk_idx) ||
  		    (s->failed && (disk_idx == s->failed_num[0] ||
-				   disk_idx == s->failed_num[1]))) {
+				   disk_idx == s->failed_num[1])))) {
  			/* have disk failed, and we're requested to fetch it;
  			 * do compute it
  			 */


