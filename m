>=20
>=20
> Using the following script (/tmp/show_attributes):
>     #!/bin/sh
>     FILES=3D`ls *`
>     for file in $FILES; do
>       if [ -f $file ] ; then
>         echo "$file : " `cat $file`
>       fi
>     done
