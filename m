 drivers/scsi/aacraid/commsup.c  |   17 ++++++++---------
 drivers/scsi/aacraid/linit.c    |   10 +++++-----
 drivers/scsi/aacraid/rx.c       |    2 +-
 6 files changed, 22 insertions(+), 24 deletions(-)

