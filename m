  1329		 * [3:0]   = Type
  1330		 */
  1331		if ((validation_cfg >> CDU_CONTEXT_VALIDATION_CFG_USE_CID) & 1)
  1332			validation_string |= (cid & 0xFFF00000) | ((cid & 0xFFF) << 8);
